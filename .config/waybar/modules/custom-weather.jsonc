{
  "custom/weather": {
    "exec-if": "which wttrbar",
    "exec": "wttrbar --location Ahmedabad",
    "restart-interval": 300,
    "tooltip": true,
    "format": "{}°",
    "return-type": "json",
    "on-click": "ghostty --class=center-float -e fish -c 'wttr Ahmedabad; read -P \\'Press enter to close...\\''",
    "on-click-right": "ghostty --class=center-float -e fish -c 'wttr -v2 Ahmedabad; read -P \\'Press enter to close...\\''",
    "on-click-middle": "xdg-open https://wttr.in/Ahmedabad",
  },
}

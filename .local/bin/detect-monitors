#!/usr/bin/env bash
# =============================================================================
# detect-monitors — Dynamic Hyprland monitor configuration
# =============================================================================
# Detects connected monitors and writes:
#   ~/.config/hypr/configs/monitors_var.conf
#
# Can run inside Hyprland (uses hyprctl) or outside (uses /sys/class/drm).
# Safe to re-run — overwrites the config file each time.
# =============================================================================

set -euo pipefail

CONFIG_DIR="${HOME}/.config/hypr/configs"
OUT_FILE="${CONFIG_DIR}/monitors_var.conf"

info()    { echo -e "\033[0;36m[detect-monitors]\033[0m $*"; }
warn()    { echo -e "\033[1;33m[detect-monitors]\033[0m $*"; }
success() { echo -e "\033[0;32m[detect-monitors]\033[0m $*"; }

mkdir -p "$CONFIG_DIR"

# ---- Detect connected outputs -----------------------------------------------

MONITORS=()

if command -v hyprctl &>/dev/null && hyprctl monitors -j &>/dev/null 2>&1; then
    # Method 1: Hyprland is running — use hyprctl
    info "Detecting monitors via hyprctl…"
    mapfile -t MONITORS < <(hyprctl monitors -j | jq -r '.[].name')
else
    # Method 2: Parse DRM subsystem (works outside Hyprland / in TTY)
    info "Hyprland not running — detecting monitors via /sys/class/drm…"
    for card_dir in /sys/class/drm/card*-*/; do
        status_file="${card_dir}status"
        if [[ -f "$status_file" ]] && [[ "$(cat "$status_file")" == "connected" ]]; then
            # Extract connector name: card0-HDMI-A-1 → HDMI-A-1
            connector="$(basename "$card_dir")"
            connector="${connector#card[0-9]-}"
            connector="${connector#card[0-9][0-9]-}"
            MONITORS+=("$connector")
        fi
    done
fi

# ---- Assign $main and $secundary --------------------------------------------

MAIN=""
SECUNDARY=""

if [[ ${#MONITORS[@]} -ge 1 ]]; then
    MAIN="${MONITORS[0]}"
fi
if [[ ${#MONITORS[@]} -ge 2 ]]; then
    SECUNDARY="${MONITORS[1]}"
fi

if [[ -z "$MAIN" ]]; then
    warn "No monitors detected! Writing empty config."
fi

# ---- Write config file -------------------------------------------------------

cat > "$OUT_FILE" <<EOF
# Auto-generated by detect-monitors — do not edit manually
# Re-run 'detect-monitors' to regenerate.
# Detected ${#MONITORS[@]} monitor(s): ${MONITORS[*]:-none}
\$main=${MAIN}
\$secundary=${SECUNDARY}
EOF

success "Wrote ${OUT_FILE}"
if [[ -n "$MAIN" ]]; then
    info "  \$main      = ${MAIN}"
fi
if [[ -n "$SECUNDARY" ]]; then
    info "  \$secundary = ${SECUNDARY}"
fi
if [[ ${#MONITORS[@]} -gt 2 ]]; then
    warn "  ${#MONITORS[@]} monitors detected but only 2 are configured."
    warn "  Additional monitors: ${MONITORS[*]:2}"
fi
